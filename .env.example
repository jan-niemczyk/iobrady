# --- baza danych ---
POSTGRES_DB=iobrady
POSTGRES_USER=iobrady
POSTGRES_PASSWORD=zmien_to_haslo_w_prod
DATABASE_URL=postgresql://iobrady:zmien_to_haslo_w_prod@localhost:5432/iobrady

# --- Auth.js ---
# wygeneruj: openssl rand -base64 32
NEXTAUTH_SECRET=zmien_to_w_produkcji_dlugi_losowy_ciag_minimum_32_znaki
NEXTAUTH_URL=http://localhost:3000

# --- domena (produkcja, Docker Compose + Caddy) ---
DOMAIN=localhost

# --- pierwsze uruchomienie ---
# Pierwsze konto operatora zakłada się przez kreator (/setup) po starcie aplikacji - nie trzeba
# nic tu ustawiać. Poniższe zmienne to opcjonalna, zapasowa ścieżka dla wdrożeń automatycznych/
# skryptowych (pomija kreator i zakłada konto od razu przy starcie kontenera).
INIT_SEED=false
SEED_OPERATOR_EMAIL=operator@example.local
SEED_OPERATOR_PASSWORD=
