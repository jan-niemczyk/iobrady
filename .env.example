# ═══════════════════════════════════════════════════════════════════════════════
#  iOBRADY - konfiguracja instalacji (plik .env)
#
#  Skopiuj:  cp .env.example .env   i uzupełnij wartości oznaczone [WYMAGANE].
#  Wartości ZMIEN_... są przykładowe - aplikacja odmówi startu, dopóki ich nie zmienisz.
#  Plik .env zawiera sekrety: nie umieszczaj go w repozytorium, ustaw `chmod 600 .env`,
#  a jego kopię (zwłaszcza APP_ENCRYPTION_KEY) przechowuj poza serwerem.
#  Sprawdzenie pliku: ./scripts/check-env.sh
# ═══════════════════════════════════════════════════════════════════════════════

# ── Adres aplikacji ─────────────────────────────────────────────────────────────

# [WYMAGANE] Publiczny adres aplikacji - dokładnie taki, jaki wpisują użytkownicy w przeglądarce,
# bez ukośnika na końcu. Używany w ciasteczkach sesji (https = ciasteczka szyfrowane) i w linkach
# w e-mailach. Produkcja: https://obrady.twoja-domena.pl   Próba lokalna: http://localhost
NEXTAUTH_URL=https://ZMIEN.twoja-domena.pl

# [WYMAGANE] Domena, dla której serwer WWW (Caddy) automatycznie pobierze certyfikat HTTPS
# (Let's Encrypt). Ten sam host co w NEXTAUTH_URL, bez https://.
# Próba lokalna bez certyfikatu: DOMAIN=http://localhost (i NEXTAUTH_URL=http://localhost).
DOMAIN=ZMIEN.twoja-domena.pl

# ── Bezpieczeństwo ──────────────────────────────────────────────────────────────

# [WYMAGANE] Sekret podpisujący sesje (min. 32 znaki). Wygeneruj:  openssl rand -base64 32
# Zmiana sekretu wylogowuje wszystkich użytkowników.
NEXTAUTH_SECRET=ZMIEN_NA_WYNIK_OPENSSL_RAND

# [ZALECANE] Klucz szyfrowania sekretów zapisanych w bazie (hasło SMTP), 32 bajty w base64.
# Wygeneruj:  openssl rand -base64 32
# Bez tego klucza hasła SMTP z kopii zapasowej nie da się odczytać - trzymaj kopię poza serwerem.
# Puste = klucz wyprowadzany z NEXTAUTH_SECRET (działa, ale zmiana NEXTAUTH_SECRET uniemożliwi odczyt).
APP_ENCRYPTION_KEY=

# [OPCJONALNE] Poprzednie klucze (po przecinku) - tylko na czas rotacji klucza (INSTALACJA.md, „Klucze i sekrety”).
APP_ENCRYPTION_KEYS_OLD=

# [OPCJONALNE] Kod instalacyjny kreatora pierwszego uruchomienia (/setup), min. 12 znaków.
# Puste = kod jest losowany przy starcie i wypisywany w logu:  docker compose logs app | grep setup
SETUP_TOKEN=

# ── Baza danych (kontener PostgreSQL w Docker Compose) ──────────────────────────

# [WYMAGANE] Hasło bazy - tylko litery, cyfry i . _ ~ - (trafia do adresu bazy). Wygeneruj:  openssl rand -hex 24
# UWAGA: hasło jest zapisywane w bazie przy PIERWSZYM uruchomieniu - późniejsza zmiana w .env
# nie zmienia hasła w istniejącej bazie (skrypt ./scripts/check-env.sh wykryje niezgodność).
POSTGRES_PASSWORD=ZMIEN_NA_MOCNE_HASLO_BAZY

# [OPCJONALNE] Nazwa użytkownika i bazy (domyślnie: iobrady). Jak hasło - ustalane przy pierwszym starcie.
POSTGRES_USER=iobrady
POSTGRES_DB=iobrady

# [TYLKO DO PRACY NAD KODEM] Adres bazy dla `npm run dev` / skryptów uruchamianych poza Dockerem.
# W Docker Compose ustawiany automatycznie z POSTGRES_* - na produkcji NIE jest potrzebny.
# DATABASE_URL=postgresql://iobrady:HASLO@localhost:5432/iobrady

# ── Pozostałe ───────────────────────────────────────────────────────────────────

# [OPCJONALNE] Strefa czasowa serwera i bazy (domyślnie Europe/Warsaw).
TZ=Europe/Warsaw

# [OPCJONALNE] Nazwa projektu Docker Compose - od niej zależą nazwy wolumenów z danymi.
# Domyślnie nazwa katalogu aplikacji. NIE zmieniaj po pierwszym uruchomieniu (dane są w wolumenach
# <nazwa>_esog_db, <nazwa>_esog_uploads, <nazwa>_iobrady_attachments).
# COMPOSE_PROJECT_NAME=iobrady

# [OPCJONALNE, zamiast kreatora] Założenie konta operatora przy starcie (wdrożenia skryptowe).
# Zalecane: zostaw INIT_SEED=false i utwórz konto w kreatorze /setup.
INIT_SEED=false
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=

# Uwaga: TRUST_PROXY (adres klienta z X-Forwarded-For) ustawia docker-compose.yml, bo aplikacja
# zawsze działa tam za serwerem Caddy. Nie ustawiaj go, gdy aplikacja jest wystawiona bez proxy.
